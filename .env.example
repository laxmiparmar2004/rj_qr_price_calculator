# Supabase Configuration
# Get these values from your Supabase project settings
# Visit: https://app.supabase.com -> Project Settings -> API

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Merchant payment details (WhatsApp number must include country code, digits only)
VITE_SHOP_WHATSAPP_NUMBER=your_whatsapp_number_with_country_code
VITE_UPI_QR_IMAGE_URL=/your-upi-qr-image.png
